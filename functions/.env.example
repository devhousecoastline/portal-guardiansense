# Credenciais Mercado Pago (Developers → sua aplicação → Credenciais)
# Teste: Access Token de teste (TEST-...)
# Produção: Access Token de produção (APP_USR-...)
MERCADOPAGO_ACCESS_TOKEN=

# Secret do webhook (Developers → Webhooks → revelar assinatura secreta)
# Opcional no sandbox; recomendado em produção
MERCADOPAGO_WEBHOOK_SECRET=
