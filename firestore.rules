rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isCloseOysterCommand(data) {
      return data.type == 'close_oyster';
    }

    function isProtectAppCommand(data) {
      return data.type == 'protect_app';
    }

    function isProtectAppsCommand(data) {
      return data.type == 'protect_apps';
    }

    function isAllowedCommandType(data) {
      return isCloseOysterCommand(data)
        || isProtectAppCommand(data)
        || isProtectAppsCommand(data);
    }

    function isValidCloseOysterCreate(data) {
      return isCloseOysterCommand(data)
        && data.status == 'pending'
        && data.requestedBy == request.auth.uid
        && data.createdAt is timestamp
        && (!('reason' in data) || data.reason is string);
    }

    function isValidProtectAppCreate(data) {
      return isProtectAppCommand(data)
        && data.status == 'pending'
        && data.requestedBy == request.auth.uid
        && data.createdAt is timestamp
        && data.packageName is string
        && data.packageName.size() > 0
        && data.label is string
        && data.label.size() > 0
        && data.sectionId is string
        && data.sectionId.size() > 0
        && (!('reason' in data) || data.reason is string);
    }

    function isValidProtectAppsCreate(data) {
      return isProtectAppsCommand(data)
        && data.status == 'pending'
        && data.requestedBy == request.auth.uid
        && data.createdAt is timestamp
        && data.apps is list
        && data.apps.size() > 0
        && data.apps.size() <= 50
        && data.appCount is int
        && data.appCount > 0
        && data.appCount <= 50
        && (!('reason' in data) || data.reason is string);
    }

    function isValidCommandCreate() {
      let data = request.resource.data;
      return isValidCloseOysterCreate(data)
        || isValidProtectAppCreate(data)
        || isValidProtectAppsCreate(data);
    }

    function commandImmutableFieldsUnchanged(before, after) {
      return (!('reason' in before) || after.reason == before.reason)
        && (!('packageName' in before) || after.packageName == before.packageName)
        && (!('label' in before) || after.label == before.label)
        && (!('sectionId' in before) || after.sectionId == before.sectionId)
        && (!('apps' in before) || after.apps == before.apps)
        && (!('appCount' in before) || after.appCount == before.appCount);
    }

    function isValidCommandUpdate() {
      let before = resource.data;
      let after = request.resource.data;
      return isAllowedCommandType(before)
        && isAllowedCommandType(after)
        && after.type == before.type
        && after.createdAt == before.createdAt
        && after.requestedBy == before.requestedBy
        && before.status == 'pending'
        && after.status in ['applied', 'failed']
        && (!('appliedAt' in after) || after.appliedAt is timestamp)
        && (!('failureMessage' in after)
          || after.failureMessage is string)
        && commandImmutableFieldsUnchanged(before, after);
    }

    // Entitlement pago só via Admin SDK (Play verify / webhook PIX).
    function paidStore(value) {
      return value in ['play', 'pix', 'app_store'];
    }

    function subscriptionCreateEscalation() {
      return 'subscription' in request.resource.data
        && (
          request.resource.data.subscription.status == 'active'
          || (
            'store' in request.resource.data.subscription
            && paidStore(request.resource.data.subscription.store)
          )
          || (
            'pixPaymentId' in request.resource.data.subscription
            && request.resource.data.subscription.pixPaymentId != null
          )
          || (
            'expiresAt' in request.resource.data.subscription
            && request.resource.data.subscription.expiresAt != null
          )
          || (
            'startedAt' in request.resource.data.subscription
            && request.resource.data.subscription.startedAt != null
          )
        );
    }

    function subscriptionUpdateEscalation() {
      return 'subscription' in request.resource.data
        && (
          (
            request.resource.data.subscription.status == 'active'
            && (
              !('subscription' in resource.data)
              || resource.data.subscription.status != 'active'
            )
          )
          || (
            'store' in request.resource.data.subscription
            && paidStore(request.resource.data.subscription.store)
            && (
              !('subscription' in resource.data)
              || !('store' in resource.data.subscription)
              || resource.data.subscription.store
                != request.resource.data.subscription.store
            )
          )
          || (
            'pixPaymentId' in request.resource.data.subscription
            && request.resource.data.subscription.pixPaymentId != null
            && (
              !('subscription' in resource.data)
              || resource.data.subscription.pixPaymentId
                != request.resource.data.subscription.pixPaymentId
            )
          )
          || (
            'expiresAt' in request.resource.data.subscription
            && request.resource.data.subscription.expiresAt != null
            && (
              !('subscription' in resource.data)
              || !('expiresAt' in resource.data.subscription)
              || request.resource.data.subscription.expiresAt
                > resource.data.subscription.expiresAt
            )
          )
          || (
            'startedAt' in request.resource.data.subscription
            && request.resource.data.subscription.startedAt != null
            && (
              !('subscription' in resource.data)
              || !('startedAt' in resource.data.subscription)
              || request.resource.data.subscription.startedAt
                != resource.data.subscription.startedAt
            )
          )
        );
    }

    function clientCannotSetVerification() {
      let d = request.resource.data;
      return (!('verified' in d) || d.verified == false)
        && !('verifiedAt' in d)
        && !('verifiedVia' in d);
    }

    function verificationUnchanged() {
      let before = resource.data;
      let after = request.resource.data;
      return (
          (!('verified' in before) && !('verified' in after))
          || (
            'verified' in before
            && 'verified' in after
            && after.verified == before.verified
          )
        )
        && (
          (!('verifiedAt' in before) && !('verifiedAt' in after))
          || (
            'verifiedAt' in before
            && 'verifiedAt' in after
            && after.verifiedAt == before.verifiedAt
          )
        )
        && (
          (!('verifiedVia' in before) && !('verifiedVia' in after))
          || (
            'verifiedVia' in before
            && 'verifiedVia' in after
            && after.verifiedVia == before.verifiedVia
          )
        );
    }

    function validUserCreate() {
      return !subscriptionCreateEscalation();
    }

    function validUserUpdate() {
      return !subscriptionUpdateEscalation();
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId) && validUserCreate();
      allow update: if isOwner(userId) && validUserUpdate();
      allow delete: if false;

      match /devices/{deviceId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && clientCannotSetVerification();
        allow update: if isOwner(userId) && verificationUnchanged();
        allow delete: if false;

        match /events/{eventId} {
          allow read: if isOwner(userId);
          allow create, update: if isOwner(userId);
          allow delete: if isOwner(userId);
        }

        match /commands/{commandId} {
          allow read: if isOwner(userId);
          allow create: if isOwner(userId) && isValidCommandCreate();
          allow update: if isOwner(userId) && isValidCommandUpdate();
          allow delete: if isOwner(userId);
        }
      }

      // Legado — timeline antiga em users/{uid}/events (app ainda limpa aqui).
      match /events/{eventId} {
        allow read: if isOwner(userId);
        allow create, update, delete: if isOwner(userId);
      }

      // QR de vínculo — só Admin SDK (Functions) escreve.
      match /devicePairings/{pairingId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }
    }

    // Cobranças PIX — só Admin SDK (Functions).
    match /pixPayments/{paymentId} {
      allow read, write: if false;
    }
  }
}
